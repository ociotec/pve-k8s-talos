{
  "uid": "vpa-goldilocks",
  "title": "VPA and Goldilocks",
  "description": "VPA recommendations per workload/container and exporter health. Recommendations are advisory, not automatic resource changes. Missing recommendations are not zero values.",
  "id": null,
  "version": 1,
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "tags": [
    "infrastructure",
    "monitoring",
    "vpa",
    "goldilocks"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "VPA objects",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\"})",
          "legendFormat": "{{namespace}} / {{target_name}} / {{container}} · {{bound}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "VPAs with recommendations",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(kube_verticalpodautoscaler_status_condition{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\",condition=\"RecommendationProvided\"} == 1) or (0 * count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\"}))",
          "legendFormat": "{{namespace}} / {{target_name}} / {{container}} · {{bound}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "VPAs awaiting recommendations",
      "type": "stat",
      "description": "New workloads or workloads without usage samples may not have recommendations yet. An absent recommendation is not a zero recommendation.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\"} unless on(namespace,verticalpodautoscaler) (kube_verticalpodautoscaler_status_condition{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\",condition=\"RecommendationProvided\"} == 1)) or (0 * count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\"}))",
          "legendFormat": "{{namespace}} / {{target_name}} / {{container}} · {{bound}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
