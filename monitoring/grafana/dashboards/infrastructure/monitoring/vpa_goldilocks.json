        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\",update_mode=\"Off\"}) or (0 * count(kube_verticalpodautoscaler_info{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\"}))",
          "legendFormat": "{{namespace}} / {{target_name}} / {{container}} · {{bound}}",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "CPU recommendations per container",
      "type": "timeseries",
      "description": "Lower bound, target and upper bound in CPU cores. Recommendations do not modify workloads.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "cores",
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "kube_verticalpodautoscaler_recommendation{namespace=~\"$namespace\",target_kind=~\"$kind\",target_name=~\"$workload\",container=~\"$container\",resource=\"cpu\",bound=~\"lowerBound|target|upperBound\"}",
          "legendFormat": "{{namespace}} / {{target_name}} / {{container}} · {{bound}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
